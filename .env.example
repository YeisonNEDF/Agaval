# Copiar como .env y reemplazar los valores. Nunca versionar el archivo .env real.
# Para migraciones use conexión directa o pooler en modo sesión de Supabase.
AGAVAL_DATABASE_CONNECTION=Host=aws-0-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
