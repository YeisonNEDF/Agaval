# Identidad del proyecto en Docker Compose.
COMPOSE_PROJECT_NAME=agaval

# Puertos publicados en la máquina anfitriona.
FRONTEND_PORT=4200
BACKEND_PORT=5100
SQLSERVER_PORT=1433

# SQL Server 2022. La imagen es x86-64; Docker Desktop la emula en Apple Silicon.
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
SQLSERVER_PLATFORM=linux/amd64
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=Agaval_local_2026!
DATABASE_NAME=GestorInventarioDB

# La API aplica migraciones y carga datos de demostración al iniciar Compose.
ASPNETCORE_ENVIRONMENT=Production
APPLY_MIGRATIONS_ON_STARTUP=true

# Host que el navegador utiliza para acceder al frontend.
PUBLIC_HOST=localhost
